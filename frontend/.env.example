# PAYGUARD AI - Frontend Environment Variables Template
# Copy this file to .env or .env.local for local frontend development.
# DO NOT commit real secrets or production credentials.

# Application branding
VITE_APP_TITLE="PAYGUARD AI"

# Backend FastAPI Service Base URL
# Local development: http://127.0.0.1:8000
# Vercel: set VITE_API_BASE_URL in the project settings to the Render address (see docs/DEPLOYMENT.md).
# The Vercel build stops if it is missing.
VITE_API_BASE_URL="http://127.0.0.1:8000"
