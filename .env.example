# PAYGUARD AI - Root Environment Variables Template
# Copy this file to .env and configure your environment-specific settings.
# DO NOT commit real secrets or production credentials to source control.

# -------------------------------------------------------------------
# Backend Settings (FastAPI)
# -------------------------------------------------------------------
PROJECT_NAME="PAYGUARD AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Network
HOST="127.0.0.1"
PORT=8000

# Allowed CORS Origins (JSON list or comma-separated in production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# -------------------------------------------------------------------
# Frontend Settings (Vite / React)
# -------------------------------------------------------------------
VITE_APP_TITLE="PAYGUARD AI"
VITE_API_BASE_URL="http://127.0.0.1:8000"

# -------------------------------------------------------------------
# Future Integration Placeholders (Phase 2+ - Do NOT configure real secrets)
# -------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/payguard_db
# REDIS_URL=redis://localhost:6379/0
# ML_MODEL_PATH=models/intent_classifier_v1.onnx
